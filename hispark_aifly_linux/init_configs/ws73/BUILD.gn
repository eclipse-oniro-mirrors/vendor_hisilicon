copy("ws73_bin") {
  sources = [
    "ws73.bin",
    "wifi_cali.bin",
    "btc_cali.bin",
    "wow.bin"
  ]
  outputs = [ "$root_out_dir/etc/ws73/{{source_file_part}}" ]
}

copy("ble_samples") {
  sources = [
    "ble_client_sample",
    "ble_server_sample",
  ]
  outputs = [ "$root_out_dir/bin/{{source_file_part}}" ]
}

copy("sle_samples") {
  sources = [
    "sle_client_sample",
    "sle_server_sample",
  ]
  outputs = [ "$root_out_dir/bin/{{source_file_part}}" ]
}

copy("ws73_cfg") {
  sources = [ "ws73_cfg.ini" ]
  outputs = [ "$root_out_dir/etc/ws73_cfg.ini" ]
}

group("ws73") {
  deps = [
    ":ws73_bin",
    ":ws73_cfg",
    ":sle_samples",
    ":ble_samples",
  ]
}