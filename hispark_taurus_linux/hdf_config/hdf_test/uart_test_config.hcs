root {
    uart_test {
        module = "uart_test";
        match_attr = "UART_TEST";
        port = 1;
        len = 64;
        /* loopback = 1: UART1 wired to a PC running uart_peer.py in echo
         * mode (or TX/RX pinned by a jumper cap) so data returns externally */
        loopback = 1;
        wbuf = [0x71, 0x47, 0x1d, 0x94, 0xec, 0x89, 0x93, 0xc7,
                0x44, 0xbc, 0xd8, 0xcf, 0xcb, 0x3c, 0xc5, 0xa6,
                0x68, 0x19, 0xa8, 0xe6, 0xca, 0xa4, 0xe2, 0x3b,
                0x69, 0xbd, 0x41, 0x89, 0x41, 0xda, 0x1e, 0xdc,
                0x4e, 0xd8, 0x36, 0x13, 0xc6, 0x82, 0x49, 0x4c,
                0x19, 0xe2, 0x74, 0x0e, 0xa9, 0x4a, 0x4f, 0x39,
                0x49, 0x20, 0xc6, 0xae, 0x77, 0x6d, 0xb8, 0xbe,
                0x59, 0x25, 0x51, 0x54, 0x7a, 0x34, 0x28, 0xe1];
    }
}